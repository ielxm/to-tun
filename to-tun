COLOR_CYAN="\033[36m"
COLOR_YELLOW="\033[33m"
COLOR_RESET="\033[0m"

setup() {
    if [ "$(id -u)" -ne 0 ]; then echo "Please, run this command as root"; exit 1; fi
    
    USER_UID="${1:-1000}"
    USER_GID="${2:-1000}"

    TUN_IFNAME="${3-tun0}"
    TUN_GATEWAY="${4-172.19.100.1}"

    VETH_NET="10.255.255.0/30"
    VETH_HOST_ADDRESS="10.255.255.1"
    VETH_CLIENT_ADDRESS="10.255.255.2"

    # automatically generated
    VETH_NET_BITS="${VETH_NET##*/}"

    ip netns del T 2>/dev/null || true
    ip netns add T

    ip link add veth-client type veth peer name veth-host
    ip link set veth-client netns T
    ip addr add $VETH_HOST_ADDRESS/$VETH_NET_BITS dev veth-host
    ip link set veth-host up

    ip netns exec T ip addr add $VETH_CLIENT_ADDRESS/$VETH_NET_BITS dev veth-client

    ip netns exec T ip link set veth-client up
    ip netns exec T ip link set lo up

    ip netns exec T ip route add default via $VETH_HOST_ADDRESS

    ip rule add from $VETH_NET table 100

    ip netns exec T sysctl -w net.ipv4.ping_group_range="$USER_UID $USER_GID"

    #sysctl -w net.ipv4.ip_forward=1
}

enter_ns() {
    program="$1"
    program_path="$(command -v "$program")"

    /usr/local/bin/enter_ns "$program_path" "${@:2}"
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --help|-help|help|--h|-h)
            echo -e "${COLOR_YELLOW}Usage:${COLOR_RESET}"
            echo -e "    -> to-tun <program> [args...]"
            echo -e "    -> to-tun setup ${COLOR_CYAN}YOUR_USER_UID YOUR_USER_GID TUN_IFNAME TUN_GATEWAY${COLOR_RESET}"
            exit 0
            ;;
        setup)
            setup
            exit 0
            ;;
        *)
            enter_ns "$@"
            exit 0
    esac
done
